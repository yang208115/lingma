# Copy to .env at the workspace root. Paths resolve relative to that root.
HOST=127.0.0.1
# Required for HOST=0.0.0.0; use a private container network behind an authenticated HTTPS proxy.
# PUBLIC_ORIGIN=https://novel.example.com
PORT=3000
DATA_DIR=.data
# Defaults to DATA_DIR/tmp; must not overlap blobs or the web build.
# TEMP_DIR=.data/tmp
# WEB_DIST_DIR=apps/web/dist
SHUTDOWN_TIMEOUT_MS=10000
# P05: enter this VARIABLE NAME in Model Settings, set the value only on the server.
# LINGMA_MODEL_API_KEY=
# Public hosting requires authentication at the reverse proxy; the app has no user accounts.
# No usable provider credentials belong in this file.
