{
  "name": "@lingma/server",
  "version": "0.1.0",
  "license": "GPL-3.0-only",
  "private": true,
  "type": "module",
  "scripts": {
    "data:clean": "tsx scripts/clean-data.ts",
    "dev": "tsx watch --include '../../packages/*/dist/**/*.js' src/main.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@lingma/agent": "workspace:*",
    "@lingma/shared": "workspace:*",
    "better-sqlite3": "13.0.3",
    "hono": "4.13.16",
    "ipaddr.js": "2.5.0",
    "isomorphic-git": "1.44.10",
    "mdast-util-from-markdown": "2.0.3",
    "proper-lockfile": "4.1.2",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/proper-lockfile": "4.1.4",
    "tsx": "4.23.15"
  }
}
